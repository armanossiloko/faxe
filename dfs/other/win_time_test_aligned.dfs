def in =
|json_emitter('{"hello": "there"}')
.every(1s)
.jitter(300ms)
%.type(point)
%.align()

in
|win_clock()
.every(5s)
%.align()
%.period(10s)
%.fill_period()


|aggregate()
.fields('hello')
.functions('count')

|eval(lambda: to_iso8601("ts"), lambda: to_iso8601(now())).as('dt', 'now')

|debug()