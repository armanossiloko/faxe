def default_map =
    '{"1":"tgw/data/some/test/number1", "2":"tgw/data/some/test/number2", "3":"tgw/data/some/test/number3",
    "4":"tgw/data/some/test/number4"}'
def payload =
|json_emitter()
.every(100ms)
.json(
    '{"no": 1, "val": "10"}',
    '{"no": 2, "val": "20"}',
    '{"no": 3, "val": "30"}',
    '{"no": 4, "val": "40"}'
    )
.as('data')
.select('seq')

|eval(
    lambda: map_get(string("data.no"), default_map),
    lambda: if(undefined("topic"), 'tgw/data/some/test/default', "topic")
    )
.as(
    'topic',
    'topic'
    )


|mqtt_publish()
.topic_field('topic')
.use_pool(true)
